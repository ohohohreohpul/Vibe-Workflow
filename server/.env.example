# MuAPI (Vadoo AI) — get your key at muapi.ai
MU_API_KEY=your_muapi_key_here

# PostgreSQL — Supabase or Neon connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Clerk — from clerk.com dashboard > API Keys
# JWKS URL: https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# Stripe — from stripe.com dashboard
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — create products in Stripe dashboard first
# Starter: 100 credits for $9
STRIPE_PRICE_STARTER=price_...
# Pro: 500 credits for $39
STRIPE_PRICE_PRO=price_...
# Studio: 1500 credits for $99
STRIPE_PRICE_STUDIO=price_...

# Your deployed frontend URL (for Stripe redirects)
FRONTEND_URL=http://localhost:3000
