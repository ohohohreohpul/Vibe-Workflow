# ── Backend ───────────────────────────────────────────────────────────────────

# MuAPI (Vadoo AI) — get your key at muapi.ai
MU_API_KEY=your_muapi_key_here

# PostgreSQL — Supabase or Neon connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Clerk — from clerk.com dashboard > API Keys
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_STUDIO=price_...

# Your deployed frontend URL
FRONTEND_URL=http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────────────────

# Clerk — publishable + secret keys from clerk.com dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk auth redirect URLs (Clerk reads these automatically)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/workflow
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/workflow

# Backend URL (Railway/Render deployed URL in production)
API_URL=http://localhost:8000
